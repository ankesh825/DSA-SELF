//Quick Sort
Quick Sort mein ek pivot element select karte hain, smaller elements left aur greater elements right rakhte hain, phir dono parts ko recursively sort karte hain.
#include <iostream>
using namespace std;

int partition(int arr[], int low, int high) {
    int pivot = arr[high];
    int i = low - 1;

    for (int j = low; j < high; j++) {
        if (arr[j] < pivot) {
            i++;

            int temp = arr[i];
            arr[i] = arr[j];
            arr[j] = temp;
        }
    }

    int temp = arr[i + 1];
    arr[i + 1] = arr[high];
    arr[high] = temp;

    return i + 1;
}

void quickSort(int arr[], int low, int high) {
    if (low < high) {
        int pi = partition(arr, low, high);

        quickSort(arr, low, pi - 1);
        quickSort(arr, pi + 1, high);
    }
}

int main() {
    int arr[8] = {77, 33, 44, 11, 88, 22, 66, 55};

    quickSort(arr, 0, 7);

    cout << "Sorted Array: ";

    for (int i = 0; i < 8; i++) {
        cout << arr[i] << " ";
    }

    return 0;
}
